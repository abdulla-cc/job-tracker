# Backend Secrets
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8000
